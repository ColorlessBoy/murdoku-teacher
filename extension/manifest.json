{
  "manifest_version": 3,
  "name": "墨墨 · Murdoku 陪练",
  "version": "0.8.20",
  "description": "Murdoku 教学/考试陪练：扩展内独立 agent、可配置 API Key、聊天记录与结构化日志。",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting"],
  "host_permissions": ["https://murdoku.com/*", "https://*.murdoku.com/*", "https://opencode.ai/*", "https://api.openai.com/*", "https://api.deepseek.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://murdoku.com/play/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_popup": "popup.html", "default_title": "墨墨 · Murdoku 陪练" }
}
