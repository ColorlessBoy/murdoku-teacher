#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

echo "[pre-commit] DSH 插件语法检查"
for f in dsh-webpane/index.js dsh-webpane/client.js dsh-webpane/headless.js dsh-webpane/history.js; do
  node --check "$f"
done
node -e "const s=require('fs').readFileSync('.agents/skills/murdoku-webpane/scripts/annotate-step.js','utf8'); new Function('return ('+s+')')"

echo "[pre-commit] 教学脚本语法检查"
node --check .agents/skills/murdoku-webpane/scripts/teaching-step.mjs
node --check .agents/skills/murdoku-webpane/scripts/prelude.mjs
node --check scripts/murdoku-ledger.mjs
node --check scripts/murdoku-state.mjs

echo "[pre-commit] ok（旧 Chrome 扩展测试已归档，见 archive/chrome-extension/）"
